<% const fmt = n => "₦" + Number(n || 0).toLocaleString("en-NG", { maximumFractionDigits: 2 }); %>

<style>
  .co-wrap { max-width: 1100px; margin: 0 auto; padding: 24px 16px 48px; }
  .co-wrap h1 { margin: 0 0 20px; font-size: 26px; }
  .co-layout { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 24px; align-items: start; }
  .co-card { background: var(--white); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); padding: 22px; }
  .co-card h2 { font-size: 18px; margin: 0 0 16px; }
  .co-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 16px; }
  .co-form .full { grid-column: 1 / -1; }
  .co-form label { font-size: 13px; font-weight: 500; display: block; margin-bottom: 4px; }
  .co-form input, .co-form textarea { width: 100%; }

  .co-item { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 8px 0; }
  .co-item img { width: 48px; height: 48px; border-radius: 6px; background: #f6f6f6; object-fit: contain; border: 1px solid #eee; }
  .co-item-name { font-size: 14px; overflow-wrap: anywhere; }
  .co-item-qty { font-size: 12px; color: var(--muted); }
  .co-item-price { font-weight: 600; white-space: nowrap; }
  .co-row { display: flex; justify-content: space-between; margin: 10px 0; }
  .co-row.green { color: #15803d; }
  .co-row.total { font-size: 20px; font-weight: 700; border-top: 1px solid #eee; padding-top: 14px; }
  .co-alert { background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; border-radius: var(--r-md); padding: 10px 14px; margin-bottom: 16px; }
  .co-edit { font-size: 13px; color: var(--primary-dark); }
  .co-pay { margin-top: 18px; display: grid; gap: 8px; }
  .co-pay-title { font-weight: 600; font-size: 14px; }
  .co-pay-opt {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 10px; align-items: center;
    border: 1px solid var(--border); border-radius: var(--r-md); padding: 12px; cursor: pointer; margin: 0;
  }
  .co-pay-opt:has(input:checked) { border-color: var(--primary-dark); background: rgba(134, 102, 15, .06); }
  .co-pay-opt input { width: auto; margin: 0; }
  .co-pay-opt small { display: block; color: var(--muted); font-size: 12px; font-weight: 400; }
  .co-pay-opt i { color: var(--muted); }

  @media (max-width: 900px) {
    .co-layout { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 520px) {
    .co-form { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<div class="co-wrap">
  <h1>Checkout</h1>

  <% if (typeof checkoutError !== "undefined" && checkoutError) { %>
    <div class="co-alert"><%= checkoutError %></div>
  <% } %>

  <div class="co-layout">

    <div class="co-card">
      <h2>Shipping Details</h2>
      <form id="checkoutForm" class="co-form" method="POST" action="/cart/checkout">
        <div class="full">
          <label>Full Name</label>
          <input type="text" name="fullname" value="<%= user.fullname || '' %>" required>
        </div>
        <div>
          <label>Email</label>
          <input type="email" name="email" value="<%= user.email || '' %>" required>
        </div>
        <div>
          <label>Phone Number</label>
          <input type="tel" name="phone" value="<%= user.phone || '' %>" required>
        </div>
        <div class="full">
          <label>Address</label>
          <textarea name="address" rows="3" required><%= user.address || '' %></textarea>
        </div>
        <div>
          <label>City</label>
          <input type="text" name="city" value="<%= user.city || '' %>" required>
        </div>
        <div>
          <label>State</label>
          <input type="text" name="state" value="<%= user.state || '' %>" required>
        </div>
      </form>
    </div>

    <aside class="co-card">
      <div style="display:flex; justify-content:space-between; align-items:baseline;">
        <h2>Order Summary</h2>
        <a class="co-edit" href="/cart">Edit cart</a>
      </div>

      <% summary.items.forEach(item => { %>
        <div class="co-item">
          <img src="<%= item.image_url %>" alt="">
          <div>
            <div class="co-item-name"><%= item.name %></div>
            <div class="co-item-qty">Qty <%= item.quantity %> × <%= fmt(item.price) %></div>
          </div>
          <div class="co-item-price"><%= fmt(item.price * item.quantity) %></div>
        </div>
      <% }) %>

      <div class="co-row" style="border-top:1px solid #eee; padding-top:12px;">
        <span>Subtotal</span><span><%= fmt(summary.subtotal) %></span>
      </div>
      <% if (summary.saleSavings > 0) { %>
        <div class="co-row green"><span>Sale savings (included)</span><span>-<%= fmt(summary.saleSavings) %></span></div>
      <% } %>
      <% if (summary.coupon) { %>
        <div class="co-row green"><span>Coupon (<%= summary.coupon.code %>)</span><span>-<%= fmt(summary.discount) %></span></div>
      <% } else if (summary.couponError) { %>
        <div class="co-alert" style="font-size:13px">Coupon not applied: <%= summary.couponError %></div>
      <% } %>
      <div class="co-row total"><span>Total</span><span><%= fmt(summary.total) %></span></div>

      <% const payOnline = typeof paystackEnabled !== "undefined" && paystackEnabled; %>
      <div class="co-pay">
        <div class="co-pay-title">Payment method</div>
        <% if (payOnline) { %>
          <label class="co-pay-opt">
            <input type="radio" name="payment_method" value="paystack" form="checkoutForm" checked required>
            <span>
              <strong>Pay online now</strong>
              <small>Card, bank transfer or USSD — secured by Paystack</small>
            </span>
            <i class="fa-solid fa-lock"></i>
          </label>
        <% } %>
        <label class="co-pay-opt">
          <input type="radio" name="payment_method" value="bank_transfer" form="checkoutForm" <%= payOnline ? "" : "checked" %> required>
          <span>
            <strong>Manual bank transfer</strong>
            <small>We'll send our account details; your order ships once payment is confirmed</small>
          </span>
          <i class="fa-solid fa-building-columns"></i>
        </label>
      </div>

      <button type="submit" form="checkoutForm" class="btn btn-primary btn-full" id="placeOrderBtn" style="margin-top: var(--s-md);">
        <%= payOnline ? "Pay" : "Place Order" %> · <%= fmt(summary.total) %>
      </button>
      <script>
        (() => {
          const form = document.getElementById("checkoutForm");
          const btn = document.getElementById("placeOrderBtn");
          const label = () => {
            const m = document.querySelector("input[name=payment_method]:checked");
            btn.textContent = (m && m.value === "paystack" ? "Pay" : "Place Order") + " · <%= fmt(summary.total) %>";
          };
          document.querySelectorAll("input[name=payment_method]").forEach(r => r.addEventListener("change", label));
          // Prevent double orders from double clicks
          form.addEventListener("submit", () => { btn.disabled = true; btn.textContent = "Please wait…"; });
        })();
      </script>
    </aside>

  </div>
</div>
