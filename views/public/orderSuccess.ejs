<%
  const fmt = n => "₦" + Number(n || 0).toLocaleString("en-NG", { maximumFractionDigits: 2 });
  const paid = order.payment_status === "paid";
%>

<div style="max-width:560px; margin:40px auto; padding:0 16px;">
  <div style="background:var(--white); border-radius:var(--r-lg); box-shadow:var(--shadow-sm); padding:32px; text-align:center;">

    <% if (paid) { %>
      <div style="font-size:48px; color:#16a34a;"><i class="fa-solid fa-circle-check"></i></div>
      <h1 style="font-size:24px; margin:10px 0 6px;">Payment successful!</h1>
      <p style="color:var(--muted); margin:0 0 4px;">Thank you — we're preparing your order now.</p>
    <% } else { %>
      <div style="font-size:48px; color:var(--primary-dark);"><i class="fa-solid fa-receipt"></i></div>
      <h1 style="font-size:24px; margin:10px 0 6px;">Order placed — awaiting payment</h1>
      <p style="color:var(--muted); margin:0 0 4px;">We'll contact you with our bank details. Your order ships once payment is confirmed.</p>
    <% } %>
    <p style="color:var(--muted); margin:0 0 20px;">Order number <strong style="color:var(--black)"><%= order.order_number %></strong></p>

    <div style="text-align:left; border-top:1px solid #eee; padding-top:14px;">
      <% order.items.forEach(i => { %>
        <div style="display:flex; justify-content:space-between; gap:12px; margin:6px 0; font-size:14px;">
          <span><%= i.name || "Item" %> × <%= i.quantity %></span><span><%= fmt(i.price * i.quantity) %></span>
        </div>
      <% }) %>
      <div style="display:flex; justify-content:space-between; margin-top:12px;"><span>Subtotal</span><span><%= fmt(order.subtotal_amount ?? order.total_amount) %></span></div>
      <% if (Number(order.discount_amount) > 0) { %>
        <div style="display:flex; justify-content:space-between; color:#15803d;"><span>Coupon (<%= order.coupon_code %>)</span><span>-<%= fmt(order.discount_amount) %></span></div>
      <% } %>
      <div style="display:flex; justify-content:space-between; font-weight:700; font-size:18px; border-top:1px solid #eee; margin-top:10px; padding-top:10px;">
        <span><%= paid ? "Total paid" : "Total due" %></span><span><%= fmt(order.total_amount) %></span>
      </div>
      <% if (order.customer_email) { %>
        <p style="font-size:13px; color:var(--muted); margin-top:12px;">
          <%= paid ? "A receipt has been sent to" : "We'll be in touch at" %> <strong><%= order.customer_email %></strong>.
        </p>
      <% } %>
      <% if (paid && order.payment_reference) { %>
        <p style="font-size:12px; color:var(--muted); margin:0;">Payment reference: <%= order.payment_reference %></p>
      <% } %>
    </div>

    <a href="/products" class="btn btn-primary" style="margin-top:20px;">Continue Shopping</a>
  </div>
</div>
