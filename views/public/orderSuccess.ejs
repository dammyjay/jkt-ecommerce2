<% const fmt = n => "₦" + Number(n || 0).toLocaleString("en-NG", { maximumFractionDigits: 2 }); %>

<div style="max-width:560px; margin:40px auto; padding:0 16px;">
  <div style="background:var(--white); border-radius:var(--r-lg); box-shadow:var(--shadow-sm); padding:32px; text-align:center;">
    <div style="font-size:48px; color:#16a34a;"><i class="fa-solid fa-circle-check"></i></div>
    <h1 style="font-size:24px; margin:10px 0 6px;">Thank you! Your order is placed.</h1>
    <p style="color:var(--muted); margin:0 0 20px;">Order number <strong style="color:var(--black)"><%= orderNumber %></strong></p>

    <div style="text-align:left; border-top:1px solid #eee; padding-top:14px;">
      <% summary.items.forEach(i => { %>
        <div style="display:flex; justify-content:space-between; gap:12px; margin:6px 0; font-size:14px;">
          <span><%= i.name %> × <%= i.quantity %></span><span><%= fmt(i.price * i.quantity) %></span>
        </div>
      <% }) %>
      <div style="display:flex; justify-content:space-between; margin-top:12px;"><span>Subtotal</span><span><%= fmt(summary.subtotal) %></span></div>
      <% if (summary.discount > 0) { %>
        <div style="display:flex; justify-content:space-between; color:#15803d;"><span>Coupon (<%= summary.coupon.code %>)</span><span>-<%= fmt(summary.discount) %></span></div>
      <% } %>
      <div style="display:flex; justify-content:space-between; font-weight:700; font-size:18px; border-top:1px solid #eee; margin-top:10px; padding-top:10px;">
        <span>Total</span><span><%= fmt(summary.total) %></span>
      </div>
      <p style="font-size:13px; color:var(--muted); margin-top:12px;">Payment method: <%= payment_method %>. We'll contact you to confirm payment and delivery.</p>
    </div>

    <a href="/products" class="btn btn-primary" style="margin-top:20px;">Continue Shopping</a>
  </div>
</div>
