<style>
  .hd-wrap { max-width: 1200px; margin: 0 auto; padding: 24px 16px 48px; }
  .hd-head { display: flex; justify-content: space-between; align-items: end; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }
  .hd-head h1 { margin: 0; font-size: 28px; }
  .hd-head p { margin: 4px 0 0; color: var(--muted); }

  .hd-campaigns { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 16px; margin-bottom: 32px; }
  .hd-campaign {
    position: relative; display: block; overflow: hidden; border-radius: var(--r-lg);
    min-height: 170px; color: #fff; text-decoration: none; box-shadow: var(--shadow-sm);
    background: linear-gradient(135deg, var(--primary-dark), var(--black));
    border: 3px solid transparent; transition: transform .2s ease;
  }
  .hd-campaign:hover { transform: translateY(-2px); }
  .hd-campaign.selected { border-color: var(--danger); }
  .hd-campaign img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hd-campaign .hd-overlay {
    position: relative; height: 100%; min-height: 170px; padding: 18px 20px;
    display: flex; flex-direction: column; justify-content: flex-end; gap: 4px;
    background: linear-gradient(to top, rgba(0,0,0,.75), rgba(0,0,0,.1) 70%);
  }
  .hd-campaign .hd-off { font-size: 26px; font-weight: 800; line-height: 1; }
  .hd-campaign .hd-title { font-size: 17px; font-weight: 600; }
  .hd-campaign .hd-desc { font-size: 13px; opacity: .9; overflow-wrap: anywhere; }
  .hd-campaign .hd-timer { font-size: 12px; font-weight: 600; background: rgba(239,68,68,.95); align-self: flex-start; padding: 3px 8px; border-radius: 4px; margin-top: 4px; }

  .hd-filter { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; align-items: center; }
  .hd-filter a { font-size: 13px; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--border); text-decoration: none; color: var(--text); background: var(--white); }
  .hd-filter a.on { background: var(--black); color: #fff; border-color: var(--black); }

  .hd-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr)); gap: 16px; }
  .hd-card { position: relative; background: var(--white); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); text-decoration: none; color: inherit; overflow: hidden; display: flex; flex-direction: column; transition: transform .2s, box-shadow .2s; }
  .hd-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .hd-img { aspect-ratio: 1 / 1; background: #f6f6f6; }
  .hd-img img { width: 100%; height: 100%; object-fit: contain; padding: 14px; }
  .hd-body { padding: 12px 14px 16px; display: flex; flex-direction: column; gap: 6px; }
  .hd-name { font-size: 14px; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .hd-tag { font-size: 11px; color: var(--muted); }
  .hd-empty { text-align: center; padding: 60px 16px; background: var(--white); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); color: var(--muted); }
</style>

<div class="hd-wrap">
  <div class="hd-head">
    <div>
      <h1>🔥 Hot Deals</h1>
      <p>Limited-time offers on components, kits and tools.</p>
    </div>
  </div>

  <% if (campaigns.length) { %>
    <div class="hd-campaigns">
      <% campaigns.forEach(c => { %>
        <a class="hd-campaign <%= selected === c.id ? 'selected' : '' %>" href="/promotions?campaign=<%= c.id %>">
          <% if (c.banner_url) { %><img src="<%= c.banner_url %>" alt=""><% } %>
          <div class="hd-overlay">
            <span class="hd-off"><%= discountLabel(c) %></span>
            <span class="hd-title"><%= c.title %></span>
            <% if (c.description) { %><span class="hd-desc"><%= c.description %></span><% } %>
            <% if (c.ends_at) { %>
              <span class="hd-timer" data-ends="<%= new Date(c.ends_at).toISOString() %>">…</span>
            <% } %>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>

  <div class="hd-filter">
    <a href="/promotions" class="<%= selected ? '' : 'on' %>">All deals</a>
    <% campaigns.forEach(c => { %>
      <a href="/promotions?campaign=<%= c.id %>" class="<%= selected === c.id ? 'on' : '' %>"><%= c.title %></a>
    <% }) %>
  </div>

  <% if (!deals.length) { %>
    <div class="hd-empty">
      <p>No deals running right now. Check back soon!</p>
      <a href="/products" class="btn btn-primary">Browse all products</a>
    </div>
  <% } else { %>
    <div class="hd-grid">
      <% deals.forEach(p => { %>
        <a class="hd-card" href="/products/<%= p.id %>">
          <span class="sale-ribbon">-<%= p.pricing.percentOff %>%</span>
          <div class="hd-img">
            <% if (p.image_url) { %><img src="<%= p.image_url %>" alt="<%= p.name %>" loading="lazy"><% } %>
          </div>
          <div class="hd-body">
            <p class="hd-name"><%= p.name %></p>
            <%- include('../partials/price', { pricing: p.pricing }) %>
            <span class="hd-tag"><%= p.pricing.label %></span>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>

<script>
document.querySelectorAll(".hd-timer[data-ends]").forEach(el => {
  const ends = new Date(el.dataset.ends).getTime();
  const tick = () => {
    let s = Math.max(0, Math.floor((ends - Date.now()) / 1000));
    if (!s) { el.textContent = "Ended"; return clearInterval(t); }
    const d = Math.floor(s / 86400); s %= 86400;
    const h = Math.floor(s / 3600); s %= 3600;
    const m = Math.floor(s / 60); s %= 60;
    el.textContent = "Ends in " + (d ? d + "d " : "") + `${h}h ${String(m).padStart(2, "0")}m ${String(s).padStart(2, "0")}s`;
  };
  const t = setInterval(tick, 1000);
  tick();
});
</script>
